meta {
  name: 44 Enqueue User C
  type: http
  seq: 44
}

post {
  url: {{baseUrl}}/api/matchmaking/queue
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{affinity_user_c_id_token}}
}

body:json {
  {
    "latitude": {{affinity_test_latitude}},
    "longitude": {{affinity_test_longitude}},
    "accuracyMeters": {{affinity_test_accuracy_meters}}
  }
}

script:post-response {
  const status = res.getStatus();
  if (status !== 200) {
    throw new Error(`Expected 200 OK while enqueueing User C, got ${status}.`);
  }
  const body = res.getBody();
  if (!body || body.inQueue !== true) {
    throw new Error("Expected enqueue response with inQueue=true.");
  }
  const expectedUserId = bru.getEnvVar("affinity_user_c_backend_user_id");
  if (expectedUserId && body.userId !== expectedUserId) {
    throw new Error(`Expected User C queue response for ${expectedUserId}, got ${body.userId}.`);
  }
}
