meta {
  name: 72 Get Control User Profile
  type: http
  seq: 72
}

get {
  url: {{baseUrl}}/api/me/profile
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{affinity_control_user_id_token}}
  X-Firebase-AppCheck: {{firebase_app_check_token}}
}

script:post-response {
  const status = res.getStatus();
  if (status === 404) {
    throw new Error("Control User needs an existing ACTIVE profile before matchmaking.");
  }
  if (status !== 200) {
    throw new Error(`Expected 200 OK while reading Control User profile, got ${status}.`);
  }
  const body = res.getBody();
  if (!body || !body.id || !body.userId || !body.status) {
    throw new Error("Expected profile response with id, userId and status.");
  }
  const expectedUserId = bru.getEnvVar("affinity_control_user_backend_user_id");
  if (expectedUserId && body.userId !== expectedUserId) {
    throw new Error(`Expected Control User profile to belong to ${expectedUserId}, got ${body.userId}.`);
  }
  if (body.status !== "ACTIVE") {
    throw new Error(`Control User profile status is ${body.status}. Matchmaking requires ACTIVE profiles.`);
  }
  bru.setEnvVar("affinity_control_user_profile_id", body.id);
}
