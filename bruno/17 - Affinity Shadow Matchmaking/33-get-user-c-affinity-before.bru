meta {
  name: 33 Get User C Affinity Before
  type: http
  seq: 33
}

get {
  url: {{baseUrl}}/api/me/profile/affinity-answers
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{affinity_user_c_id_token}}
  X-Firebase-AppCheck: {{firebase_app_check_token}}
}

script:post-response {
  const status = res.getStatus();
  if (status !== 200) {
    throw new Error(`Expected 200 OK while reading User C affinity answers, got ${status}.`);
  }
  const body = res.getBody();
  if (!body || !Array.isArray(body.answers)) {
    throw new Error("Expected affinity answers response with answers array.");
  }
}
