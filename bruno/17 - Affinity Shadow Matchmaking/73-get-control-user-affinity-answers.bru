meta {
  name: 73 Get Control User Affinity Answers
  type: http
  seq: 73
}

get {
  url: {{baseUrl}}/api/me/profile/affinity-answers
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{affinity_control_user_id_token}}
  X-Firebase-AppCheck: {{firebase_app_check_token}}
}

script:post-response {
  const status = res.getStatus();
  if (status !== 200) {
    throw new Error(`Expected 200 OK while reading Control User affinity answers, got ${status}.`);
  }
  const body = res.getBody();
  if (!body || !Array.isArray(body.answers)) {
    throw new Error("Expected affinity answers response with answers array.");
  }
  if (body.answers.length !== 0) {
    throw new Error(`Control User must have zero affinity answers for this scenario, got ${body.answers.length}. Do not patch or delete answers as part of this flow.`);
  }
}
