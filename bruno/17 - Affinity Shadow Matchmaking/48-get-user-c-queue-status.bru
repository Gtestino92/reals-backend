meta {
  name: 48 Get User C Queue Status
  type: http
  seq: 48
}

get {
  url: {{baseUrl}}/api/matchmaking/queue
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{affinity_user_c_id_token}}
  X-Firebase-AppCheck: {{firebase_app_check_token}}
}

script:post-response {
  const status = res.getStatus();
  if (status !== 200) {
    throw new Error(`Expected 200 OK while checking User C queue status, got ${status}.`);
  }
  const body = res.getBody();
  if (!body || body.inQueue !== true) {
    throw new Error("Expected queue status inQueue=true before processing.");
  }
  const expectedUserId = bru.getEnvVar("affinity_user_c_backend_user_id");
  if (expectedUserId && body.userId !== expectedUserId) {
    throw new Error(`Expected User C queue status for ${expectedUserId}, got ${body.userId}.`);
  }
}
