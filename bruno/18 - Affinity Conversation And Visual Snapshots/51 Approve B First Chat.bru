meta {
  name: 51 Approve B First Chat
  type: http
  seq: 51
}

post {
  url: {{baseUrl}}/api/matches/{{affinity_pr3_control_match_id}}/chat-decision
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{affinity_user_b_id_token}}
}

body:json {
  {
    "decision": "APPROVED"
  }
}

script:post-response {
  const status = res.getStatus();
  if (status !== 200) {
    throw new Error(`Expected 200 OK while approving first chat, got ${status}.`);
  }
  const body = res.getBody();
  if (!body || body.state !== "VISUAL_PHASE") {
    throw new Error(`Expected match state VISUAL_PHASE, got ${body && body.state}.`);
  }
}
