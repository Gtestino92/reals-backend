meta {
  name: 31 Approve First Chat As A
  type: http
  seq: 31
}

post {
  url: {{baseUrl}}/api/matches/{{affinity_pr3_match_id}}/chat-decision
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{affinity_user_a_id_token}}
}

body:json {
  {
    "decision": "APPROVED"
  }
}

script:post-response {
  const status = res.getStatus();
  if (status !== 200) {
    throw new Error(`Expected 200 OK while approving first chat, got ${status}.`);
  }
  const body = res.getBody();
  if (!body || body.state !== "CHAT_ACTIVE") {
    throw new Error(`Expected match state CHAT_ACTIVE, got ${body && body.state}.`);
  }
}
