meta {
  name: 11 Restore User B Reference Answers
  type: http
  seq: 11
}

patch {
  url: {{baseUrl}}/api/me/profile/affinity-answers
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{affinity_user_b_id_token}}
}

body:json {
  {
    "answers": [
      {
        "questionId": "CINEMA_IMPORTANCE_001",
        "answerCode": "VERY_IMPORTANT"
      },
      {
        "questionId": "CINEMA_TASTE_001",
        "answerCode": "MYSTERY_TENSION"
      },
      {
        "questionId": "READING_STORIES_001",
        "answerCode": "VERY_IMPORTANT"
      },
      {
        "questionId": "MUSIC_IMPORTANCE_001",
        "answerCode": "VERY_IMPORTANT"
      },
      {
        "questionId": "MUSIC_DISCOVERY_001",
        "answerCode": "VERY_HIGH"
      },
      {
        "questionId": "LIVE_MUSIC_001",
        "answerCode": "VERY_IMPORTANT"
      },
      {
        "questionId": "DAILY_ROUTINE_RHYTHM_001",
        "answerCode": "SOMEWHAT_STRUCTURED"
      },
      {
        "questionId": "AMBITION_BALANCE_001",
        "answerCode": "GOALS_WITH_SPACE"
      },
      {
        "questionId": "MONEY_PLANS_STYLE_001",
        "answerCode": "BALANCED_PLANNING"
      },
      {
        "questionId": "COMMUNICATION_FREQUENCY_001",
        "answerCode": "HIGH"
      },
      {
        "questionId": "CONFLICT_REPAIR_001",
        "answerCode": "TALK_AFTER_SHORT_PAUSE"
      },
      {
        "questionId": "PACE_EXPECTATION_001",
        "answerCode": "INTENTIONAL"
      }
    ]
  }
}

script:post-response {
  const label = "User B";
  const status = res.getStatus();
  if (status !== 200) {
    throw new Error(`Expected 200 OK while restoring ${label} reference answers, got ${status}.`);
  }
  const body = res.getBody();
  if (!body || !Array.isArray(body.answers)) {
    throw new Error(`Expected ${label} affinity answers response with answers array.`);
  }
  const expected = {
    "CINEMA_IMPORTANCE_001": "VERY_IMPORTANT",
    "CINEMA_TASTE_001": "MYSTERY_TENSION",
    "READING_STORIES_001": "VERY_IMPORTANT",
    "MUSIC_IMPORTANCE_001": "VERY_IMPORTANT",
    "MUSIC_DISCOVERY_001": "VERY_HIGH",
    "LIVE_MUSIC_001": "VERY_IMPORTANT",
    "DAILY_ROUTINE_RHYTHM_001": "SOMEWHAT_STRUCTURED",
    "AMBITION_BALANCE_001": "GOALS_WITH_SPACE",
    "MONEY_PLANS_STYLE_001": "BALANCED_PLANNING",
    "COMMUNICATION_FREQUENCY_001": "HIGH",
    "CONFLICT_REPAIR_001": "TALK_AFTER_SHORT_PAUSE",
    "PACE_EXPECTATION_001": "INTENTIONAL"
  };
  const byQuestion = new Map(body.answers.map((answer) => [answer.questionId, answer.answerCode]));
  for (const [questionId, answerCode] of Object.entries(expected)) {
    if (byQuestion.get(questionId) !== answerCode) {
      throw new Error(`Expected ${label} affinity answer ${questionId}=${answerCode}, got ${byQuestion.get(questionId)}.`);
    }
  }
  if (byQuestion.get("MUSIC_DISCOVERY_001") !== "VERY_HIGH") {
    throw new Error(`${label} must have MUSIC_DISCOVERY_001=VERY_HIGH before PR3 snapshot assertions.`);
  }
}
