meta {
  name: 22 Mutate User A Music Answers
  type: http
  seq: 22
}

patch {
  url: {{baseUrl}}/api/me/profile/affinity-answers
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{affinity_user_a_id_token}}
}

body:json {
  {
    "answers": [
      {
        "questionId": "MUSIC_IMPORTANCE_001",
        "answerCode": "NOT_FOR_ME"
      },
      {
        "questionId": "MUSIC_DISCOVERY_001",
        "answerCode": "LOW"
      },
      {
        "questionId": "LIVE_MUSIC_001",
        "answerCode": "NOT_FOR_ME"
      }
    ]
  }
}

script:post-response {
  const status = res.getStatus();
  if (status !== 200) {
    throw new Error(`Expected 200 OK while mutating User A music answers, got ${status}.`);
  }
  const body = res.getBody();
  if (!body || !Array.isArray(body.answers)) {
    throw new Error("Expected affinity answers response with answers array.");
  }
  const byQuestion = new Map(body.answers.map((answer) => [answer.questionId, answer.answerCode]));
  const expected = {
    "MUSIC_IMPORTANCE_001": "NOT_FOR_ME",
    "MUSIC_DISCOVERY_001": "LOW",
    "LIVE_MUSIC_001": "NOT_FOR_ME"
  };
  for (const [questionId, answerCode] of Object.entries(expected)) {
    if (byQuestion.get(questionId) !== answerCode) {
      throw new Error(`Expected User A mutated answer ${questionId}=${answerCode}, got ${byQuestion.get(questionId)}.`);
    }
  }
}
