meta {
  name: 27 Request Next Question As A
  type: http
  seq: 27
}

post {
  url: {{baseUrl}}/api/chats/{{affinity_pr3_chat_id}}/guidance/next-request
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{affinity_user_a_id_token}}
}

script:post-response {
  function assertQuestionShape(question) {
    const keys = Object.keys(question || {}).sort();
    if (JSON.stringify(keys) !== JSON.stringify(["id", "instanceId", "text"])) {
      throw new Error(`Expected guidance question keys id,instanceId,text only, got ${keys.join(",")}.`);
    }
  }
  const status = res.getStatus();
  if (status !== 200) {
    throw new Error(`Expected 200 OK while requesting next question, got ${status}.`);
  }
  const body = res.getBody();
  if (!body || !body.question) {
    throw new Error("Expected first-chat guidance response.");
  }
  assertQuestionShape(body.question);
  if (body.questionOrdinal !== 1) {
    throw new Error(`Expected User A next request to remain on ordinal 1, got ${body.questionOrdinal}.`);
  }
  if (body.myNextRequested !== true) {
    throw new Error("Expected User A myNextRequested=true after first next request.");
  }
  if (body.question.id !== bru.getEnvVar("affinity_pr3_initial_question_id")) {
    throw new Error("Expected User A request to keep the initial question until User B also requests next.");
  }
}
