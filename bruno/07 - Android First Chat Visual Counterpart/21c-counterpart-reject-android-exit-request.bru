meta {
  name: 21c Counterpart Reject Android Exit Request
  type: http
  seq: 31
}

post {
  url: {{baseUrl}}/api/chats/{{counterpartFirstChatId}}/exit-requests/{{androidExitRequestId}}/rejection
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{firebase_counterpart_id_token}}
}

script:post-response {
  const body = res.getBody();
  if (body.chat.status !== "CANCELLED") {
    throw new Error(`Expected first chat CANCELLED, got ${body.chat.status}`);
  }
  if (body.exitRequest.type !== "MUTUAL_CANCEL") {
    throw new Error(`Expected MUTUAL_CANCEL, got ${body.exitRequest.type}`);
  }
  if (body.exitRequest.status !== "REJECTED") {
    throw new Error(`Expected cancellation request REJECTED, got ${body.exitRequest.status}`);
  }
  if (body.penaltyApplied !== false) {
    throw new Error("Mutual cancellation rejection should not apply a penalty today.");
  }
}
