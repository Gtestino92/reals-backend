meta {
  name: 04 Provision Firebase Counterpart
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/me/provision
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{firebase_counterpart_id_token}}
  X-Firebase-AppCheck: {{firebase_app_check_token}}
}

script:post-response {
  const status = res.getStatus();
  if (status !== 200 && status !== 201) {
    throw new Error(`Expected 200 OK or 201 Created, got ${status}`);
  }
  
  const body = res.getBody();
  if (!body || !body.id) {
    throw new Error("Expected provisioned counterpart backend user id.");
  }
  
  const expectedEmail = bru.getEnvVar("firebase_counterpart_email");
  if (body.email !== expectedEmail) {
    throw new Error(`Expected counterpart backend email ${expectedEmail}, got ${body.email}`);
  }
  
  bru.setEnvVar("counterpartUserId", body.id);
}
