meta {
  name: 10 Activate Counterpart Profile
  type: http
  seq: 17
}

post {
  url: {{baseUrl}}/api/me/profile/activation
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{firebase_counterpart_id_token}}
  X-Firebase-AppCheck: {{firebase_app_check_token}}
}

script:post-response {
  const status = res.getStatus();
  const body = res.getBody();
  if (status === 409 && body && body.code === "EMAIL_NOT_VERIFIED") {
    throw new Error("Email is still not verified in the refreshed Firebase ID token. Open the verification email, then rerun 09c and this request.");
  }
  if (status !== 200) {
    throw new Error(`Expected 200 OK for counterpart activation, got ${status}.`);
  }
  if (!body || body.status !== "ACTIVE") {
    throw new Error(`Expected counterpart profile ACTIVE, got ${body && body.status}.`);
  }
}
