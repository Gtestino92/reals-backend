meta {
  name: 08 Add Counterpart Photo 3
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/api/me/profile/photos
  body: multipartForm
  auth: none
}

headers {
  Authorization: Bearer {{firebase_counterpart_id_token}}
  X-Firebase-AppCheck: {{firebase_app_check_token}}
}

body:multipart-form {
  position: 3
  file: @file({{profile_photo_file_path}})
}
