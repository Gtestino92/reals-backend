meta {
  name: 07 Add Counterpart Photo 2
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/api/me/profile/photos
  body: multipartForm
  auth: none
}

headers {
  Authorization: Bearer {{firebase_counterpart_id_token}}
  X-Firebase-AppCheck: {{firebase_app_check_token}}
}

body:multipart-form {
  position: 2
  file: @file()
}
