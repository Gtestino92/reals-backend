meta {
  name: 16a Counterpart Request Next Guidance Question
  type: http
  seq: 24
}

post {
  url: {{baseUrl}}/api/chats/{{counterpartFirstChatId}}/guidance/next-request
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{firebase_counterpart_id_token}}
}

script:post-response {
  const body = res.getBody();
  if (!body || typeof body.questionOrdinal !== "number") {
    throw new Error("Expected first-chat guidance response.");
  }
  if (body.questionOrdinal < 2) {
    throw new Error("Expected question 2 active. Make sure Android also satisfied question 1 and requested the next guidance question.");
  }
}

docs {
  Run after the counterpart first-chat message and after Android has satisfied question 1 and requested the next guidance question from the app.
}
