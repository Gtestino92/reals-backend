meta {
  name: 02 Provision User A
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/me/provision
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{second_chat_user_a_id_token}}
  X-Firebase-AppCheck: {{firebase_app_check_token}}
}

script:pre-request {
  const token = bru.getEnvVar("second_chat_user_a_id_token");
  if (!token) {
    throw new Error("Run 01 Sign In User A before provisioning User A.");
  }

  bru.setVar("second_chat_user_a_id_token", token);
  bru.setVar("firebase_id_token", token);
  bru.setVar("firebase_email", "gtestino1992@gmail.com");
}

script:post-response {
  const status = res.getStatus();
  if (status !== 200 && status !== 201) {
    throw new Error(`Expected User A provision response 200 or 201, got ${status}`);
  }

  const body = res.getBody();
  if (!body || !body.id || !body.email) {
    throw new Error("Expected provisioned backend user id and email for User A.");
  }

  const expectedEmail = "gtestino1992@gmail.com";
  const returnedEmail = body.email.toLowerCase();
  if (returnedEmail !== expectedEmail) {
    throw new Error(
      `User A token resolved to backend email ${returnedEmail}, expected ${expectedEmail}.`
    );
  }

  bru.setEnvVar("userAId", body.id, { persist: true });
  bru.setEnvVar("androidUserId", body.id, { persist: true });
  bru.setEnvVar("firebaseUserId", body.id, { persist: true });

  // Reassert compatibility aliases after the response.
  bru.setEnvVar("firebase_email", expectedEmail, { persist: true });
  bru.setEnvVar(
    "firebase_id_token",
    bru.getEnvVar("second_chat_user_a_id_token"),
    { persist: true }
  );
}
