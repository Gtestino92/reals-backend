meta {
  name: 07 Get Second Chat Status User A
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/api/connections/{{connectionId}}/second-chat/status
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{second_chat_user_a_id_token}}
  X-Firebase-AppCheck: {{firebase_app_check_token}}
}

script:post-response {
  const body = res.getBody();
  const expectedConnectionId = bru.getEnvVar("connectionId");

  if (!body || body.connectionId !== expectedConnectionId) {
    throw new Error("Expected User A second-chat status for the discovered connection.");
  }

  if (body.chatId) {
    bru.setEnvVar("secondChatId", body.chatId, { persist: true });
  }
  if (body.scheduledAt) {
    bru.setEnvVar("secondChatScheduledAt", body.scheduledAt, { persist: true });
  }
}
