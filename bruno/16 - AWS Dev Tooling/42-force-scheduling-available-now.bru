meta {
  name: 42 Force Scheduling Available Now
  type: http
  seq: 42
}

post {
  url: {{baseUrl}}/api/local-dev/timeouts/connections/{{devConnectionId}}/scheduling-available-now
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{firebase_admin_id_token}}
}

script:post-response {
  if (res.getBody().target !== "connection-scheduling-availability") {
    throw new Error("Expected dev timeout mutation for connection scheduling availability.");
  }
}
