meta {
  name: 05 Admin Status
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/admin-auth/status
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{devAdminIdToken}}
  X-Firebase-AppCheck: {{devAdminAppCheck}}
  X-Reals-Admin-Grant: {{devAdminGrant}}
}

script:post-response {
  const body = res.getBody();
  if (res.getStatus() !== 200 || body?.configured !== true || typeof body.grantValid !== "boolean") {
    throw new Error("Administrative status failed. Check the Google identity, Web App Check and MFA configuration.");
  }
  if (!body.grantValid) bru.setVar("devAdminGrant", "");
}
