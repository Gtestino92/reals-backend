meta {
  name: 72 Reject Profile Photo Review
  type: http
  seq: 41
}

post {
  url: {{baseUrl}}/api/admin/profile-photos/{{profilePhotoReviewPhotoId}}/moderation
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{firebase_admin_id_token}}
  X-Firebase-AppCheck: {{firebase_app_check_token}}
  Content-Type: application/json
}

body:json {
  {
    "expectedPhotoVersion": {{profilePhotoReviewVersion}},
    "decision": "REJECTED",
    "notes": "AWS DEV smoke rejection"
  }
}

script:post-response {
  const status = res.getStatus();
  if (status === 401) {
    throw new Error("Expected admin Firebase bearer token. Run 00 Admin Firebase Sign In first.");
  }
  if (status === 403) {
    throw new Error("Expected allowlisted active admin user. Run 01 Provision Admin User and verify BACKOFFICE_ADMIN_EMAILS.");
  }
  if (status === 409) {
    throw new Error("Review snapshot is stale or no longer available. Run 70 List Profile Photo Review Queue again.");
  }
  if (status !== 200) {
    throw new Error(`Expected 200 OK, got ${status}.`);
  }
  
  const body = res.getBody();
  if (!body || body.photoId !== bru.getEnvVar("profilePhotoReviewPhotoId")) {
    throw new Error("Expected moderation response for profilePhotoReviewPhotoId.");
  }
  if (body.moderationStatus !== "REJECTED") {
    throw new Error(`Expected REJECTED moderationStatus, got ${body.moderationStatus}.`);
  }
  
  bru.setEnvVar("profilePhotoReviewVersion", String(body.photoVersion));
  bru.setEnvVar("profilePhotoReviewModerationStatus", body.moderationStatus);
}

docs {
  Rejects the profile photo saved by request 70.
  
  Run either 71 or 72 for a queue item, not both. If this returns 409, refresh the queue and review the current item again.
}
