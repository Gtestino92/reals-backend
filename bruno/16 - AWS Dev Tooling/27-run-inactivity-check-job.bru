meta {
  name: 27 Run Inactivity Check Job
  type: http
  seq: 27
}

post {
  url: {{baseUrl}}/api/local-dev/jobs/inactivity-check/run
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{devAdminIdToken}}
  X-Firebase-AppCheck: {{devAdminAppCheck}}
  X-Reals-Admin-Grant: {{devAdminGrant}}
}

script:post-response {
  if (res.getBody().job !== "InactivityCheckJob") {
    throw new Error("Expected InactivityCheckJob to run.");
  }
}
