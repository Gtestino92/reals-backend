meta {
  name: 27 Run Inactivity Check Job
  type: http
  seq: 16
}

post {
  url: {{baseUrl}}/api/local-dev/jobs/inactivity-check/run
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{firebase_admin_id_token}}
}

script:post-response {
  if (res.getBody().job !== "InactivityCheckJob") {
    throw new Error("Expected InactivityCheckJob to run.");
  }
}
