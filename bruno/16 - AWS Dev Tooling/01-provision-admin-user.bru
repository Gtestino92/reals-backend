meta {
  name: 01 Provision Admin User
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/me/provision
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{firebase_admin_id_token}}
  X-Firebase-AppCheck: {{firebase_app_check_token}}
}

script:pre-request {
  const token = bru.getVar("firebase_admin_id_token");
  if (!token || bru.getVar("firebase_admin_status_token") !== token) {
    throw new Error("Run 00 Validate Firebase Google ID Token and 05 Admin Status first.");
  }
}

script:post-response {
  const status = res.getStatus();
  if (status !== 200 && status !== 201) {
    throw new Error(`Expected 200 OK or 201 Created, got ${status}.`);
  }

  const body = res.getBody();
  if (!body || !body.id) {
    throw new Error("Expected provisioned backend admin user response with id.");
  }

  const expectedEmail = bru.getEnvVar("firebase_admin_email");
  if (body.email?.toLowerCase() !== expectedEmail?.trim().toLowerCase()) {
    throw new Error("Backend user email does not match the configured administrator.");
  }

  bru.setEnvVar("adminUserId", body.id);
}
