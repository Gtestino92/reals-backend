meta {
  name: 01 Provision Admin User
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/me/provision
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{firebase_admin_id_token}}
  X-Firebase-AppCheck: {{firebase_app_check_token}}
}

script:post-response {
  const status = res.getStatus();
  if (status !== 200 && status !== 201) {
    throw new Error(`Expected 200 OK or 201 Created, got ${status}.`);
  }
  
  const body = res.getBody();
  if (!body || !body.id) {
    throw new Error("Expected provisioned backend admin user response with id.");
  }
  
  const expectedEmail = bru.getEnvVar("firebase_admin_email");
  if (expectedEmail && body.email !== expectedEmail) {
    throw new Error(`Expected backend admin email ${expectedEmail}, got ${body.email}.`);
  }
  
  bru.setEnvVar("adminUserId", body.id);
}
