meta {
  name: 47 Force Chat Deadline Past
  type: http
  seq: 30
}

post {
  url: {{baseUrl}}/api/local-dev/timeouts/chats/{{devChatId}}/expire-now
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{firebase_admin_id_token}}
}

script:post-response {
  if (res.getBody().target !== "chat") {
    throw new Error("Expected dev timeout mutation for chat.");
  }
}
