meta {
  name: 52 Force Penalty Expired
  type: http
  seq: 52
}

post {
  url: {{baseUrl}}/api/local-dev/timeouts/penalties/{{devPenaltyId}}/expire-now
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{firebase_admin_id_token}}
}

script:post-response {
  if (res.getBody().target !== "penalty") {
    throw new Error("Expected dev timeout mutation for penalty.");
  }
}
