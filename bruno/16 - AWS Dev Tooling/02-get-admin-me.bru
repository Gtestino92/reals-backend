meta {
  name: 02 Get Admin Me
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/actuator/metrics/reals.app_check.requests?tag=mode:monitor&tag=outcome:valid
  body: none
  auth: none
}

params:query {
  tag: mode:monitor
  tag: outcome:valid
}

headers {
  Authorization: Bearer {{firebase_admin_id_token}}
}

script:post-response {
  const body = res.getBody();
  if (!body || !body.id) {
    throw new Error("Expected authenticated admin user response with id.");
  }
  
  bru.setEnvVar("adminUserId", body.id);
}
