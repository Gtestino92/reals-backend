meta {
  name: 02 Get Admin Me
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/me
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{devAdminIdToken}}
  X-Firebase-AppCheck: {{devAdminAppCheck}}
}

script:post-response {
  const body = res.getBody();
  if (!body || !body.id) {
    throw new Error("Expected authenticated admin user response with id.");
  }

  bru.setEnvVar("adminUserId", body.id);
}
