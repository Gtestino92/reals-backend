meta {
  name: 49 Force Second Chat Resolution Request Expired
  type: http
  seq: 32
}

post {
  url: {{baseUrl}}/api/local-dev/timeouts/second-chat-resolution-requests/{{devResolutionRequestId}}/expire-now
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{firebase_admin_id_token}}
}

script:post-response {
  if (res.getBody().target !== "second-chat-resolution-request-expiry") {
    throw new Error("Expected dev timeout mutation for second-chat resolution request expiry.");
  }
}
