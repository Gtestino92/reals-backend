meta {
  name: 00b Exchange Firebase App Check Debug Token
  type: http
  seq: 0
}

post {
  url: https://firebaseappcheck.googleapis.com/v1/projects/{{firebase_project_number}}/apps/{{firebase_admin_web_app_id}}:exchangeDebugToken?key={{firebase_api_key}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "debugToken": "{{?Registered DEV Web App Check debug secret}}",
    "limitedUse": false
  }
}

script:pre-request {
  bru.setVar("devAdminAppCheck", "");
  for (const key of ["firebase_api_key", "firebase_project_number", "firebase_admin_web_app_id"]) {
    const value = bru.getEnvVar(key);
    if (!value?.trim() || value.startsWith("paste-") || value !== bru.interpolate("{{" + key + "}}")) {
      throw new Error("Set " + key + " in the active environment and remove any override.");
    }
  }
  const appId = bru.getEnvVar("firebase_admin_web_app_id");
  const project = bru.getEnvVar("firebase_project_number");
  if (!/^[0-9]+$/.test(project) || !/^1:[0-9]+:web:[A-Za-z0-9]+$/.test(appId) ||
      appId.split(":")[1] !== project) {
    throw new Error("Configure the Firebase Web App ID and its numeric project number.");
  }
}

tests {
  test("exchange returns 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("returned App Check token is present", function () {
    const body = res.getBody();
    expect(typeof body?.token === "string" && body.token.trim().length > 0).to.equal(true);
  });
}

script:post-response {
  const status = res.getStatus();
  if (status !== 200) {
    throw new Error(`Expected Firebase App Check exchange 200, got ${status}.`);
  }

  const body = res.getBody();
  const token = body && typeof body.token === "string" ? body.token.trim() : "";
  if (!(require("jsonwebtoken").decode(token)?.exp * 1000 > Date.now())) {
    throw new Error("App Check returned an invalid or expired JWT. Check the DEV Web App debug secret and repeat 00b.");
  }

  bru.setVar("devAdminAppCheck", token);
  console.log("Web App Check credential ready for hosted DEV requests.");
}
