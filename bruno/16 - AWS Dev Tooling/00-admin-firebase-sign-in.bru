meta {
  name: 00 Firebase Admin Password Sign In
  type: http
  seq: 1
}

post {
  url: https://identitytoolkit.googleapis.com/v1/accounts:signInWithPassword?key={{firebase_api_key}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{firebase_admin_email}}",
    "password": "{{firebase_admin_password}}",
    "returnSecureToken": true
  }
}

settings {
  followRedirects: false
}

script:pre-request {
  bru.setVar("devAdminIdToken", "");
  bru.setVar("devAdminGrant", "");
  const base = bru.getEnvVar("baseUrl");
  if (!/^https:\/\/[A-Za-z0-9.-]+(?::[0-9]+)?$/.test(base) || base.includes("paste-")) {
    throw new Error("Configure baseUrl as the trusted DEV HTTPS origin.");
  }
  for (const key of ["firebase_admin_expected_uid", "firebase_admin_email", "firebase_api_key", "firebase_admin_password"]) {
    const value = bru.getEnvVar(key);
    if (!value || value.startsWith("paste-") || value !== bru.interpolate("{{" + key + "}}")) throw new Error("Configure " + key + " in the active environment.");
  }
}

script:post-response {
  if (res.getStatus() !== 200) throw new Error("Sign-in failed. Check the DEV API key, email/password provider and existing administrator credentials.");
  const token = res.getBody()?.idToken;
  const claims = require("jsonwebtoken").decode(token || "");
  if (claims?.sub !== bru.getEnvVar("firebase_admin_expected_uid").trim() ||
      claims?.email_verified !== true || claims.email?.toLowerCase() !== bru.getEnvVar("firebase_admin_email").trim().toLowerCase() ||
      claims.firebase?.sign_in_provider !== "password" || !(claims.exp * 1000 > Date.now())) {
    throw new Error("Expected a current password session for the configured verified administrator.");
  }
  bru.setVar("devAdminIdToken", token);
}
