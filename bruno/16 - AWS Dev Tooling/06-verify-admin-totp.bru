meta {
  name: 06 Verify Admin TOTP
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/admin-auth/verify
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{devAdminIdToken}}
  X-Firebase-AppCheck: {{devAdminAppCheck}}
}

body:json {
  {
    "code": "{{?Enter the current admin TOTP code}}"
  }
}

script:post-response {
  const body = res.getBody();
  if (res.getStatus() !== 200 || !/^[A-Za-z0-9_-]{43}$/.test(body?.grant) ||
      !(Date.parse(body?.expiresAt) > Date.now())) {
    throw new Error("TOTP verification failed. Repeat 00 for fresh password authentication, use a fresh code and honor Retry-After on lockout.");
  }
  bru.setVar("devAdminGrant", body.grant);
  bru.setVar("devAdminGrantExpiry", body.expiresAt);
}
