meta {
  name: 44 Force Second Chat Late Window Now
  type: http
  seq: 29
}

post {
  url: {{baseUrl}}/api/local-dev/timeouts/connections/{{devConnectionId}}/second-chat-late-window-now
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{firebase_admin_id_token}}
}

script:post-response {
  if (res.getBody().target !== "schedule-negotiation-second-chat-late-window") {
    throw new Error("Expected dev timeout mutation for second-chat late window.");
  }
}
