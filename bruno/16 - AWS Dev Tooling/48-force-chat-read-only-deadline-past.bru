meta {
  name: 48 Force Chat Read Only Deadline Past
  type: http
  seq: 33
}

post {
  url: {{baseUrl}}/api/local-dev/timeouts/chats/{{devChatId}}/read-only-expire-now
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{firebase_admin_id_token}}
}

script:post-response {
  if (res.getBody().target !== "chat-read-only") {
    throw new Error("Expected dev timeout mutation for chat read-only retention.");
  }
}
