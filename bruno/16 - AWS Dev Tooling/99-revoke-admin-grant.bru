meta {
  name: 99 Revoke Admin Grant
  type: http
  seq: 99
}

post {
  url: {{baseUrl}}/api/admin-auth/revoke
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{devAdminIdToken}}
  X-Firebase-AppCheck: {{devAdminAppCheck}}
  X-Reals-Admin-Grant: {{devAdminGrant}}
}

script:post-response {
  if (res.getStatus() !== 204) {
    throw new Error("Grant revocation failed. Check the current Firebase identity and Web App Check token.");
  }
  for (const key of ["devAdminGrant", "devAdminGrantExpiry", "devAdminIdToken", "devAdminAppCheck", "devAdminOwner", "devAdminBaseUrl"]) bru.deleteVar(key);
}
