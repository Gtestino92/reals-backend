meta {
  name: 01 Create Draft User
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/local-dev/users
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{negativeDraftEmail}}"
  }
}

script:post-response {
  const body = res.getBody();
  if (!body || !body.id) {
    throw new Error("Expected created draft user id.");
  }
  bru.setEnvVar("negativeDraftUserId", body.id);
}
