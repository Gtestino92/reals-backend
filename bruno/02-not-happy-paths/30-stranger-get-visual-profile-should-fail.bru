meta {
  name: 30 Stranger Get Visual Profile Should Fail
  type: http
  seq: 30
}

get {
  url: {{baseUrl}}/api/matches/{{negativeMatchId}}/visual-profile
  body: none
  auth: none
}

headers {
  X-Dev-User-Id: {{negativeStrangerUserId}}
}

script:post-response {
  if (res.getStatus() !== 403) {
    throw new Error(`Expected 403 Forbidden, got ${res.getStatus()}`);
  }
  const body = res.getBody();
  if (!body || body.code !== "ACCESS_DENIED") {
    throw new Error(`Expected ACCESS_DENIED, got ${body && body.code}`);
  }
}
