meta {
  name: 51 User A Safety Cancel Second Chat
  type: http
  seq: 51
}

post {
  url: {{baseUrl}}/api/chats/{{negativeSecondChatId}}/safety-cancellations
  body: json
  auth: none
}

headers {
  X-Dev-User-Id: {{negativeUserAId}}
}

body:json {
  {
    "reason": "INAPPROPRIATE_BEHAVIOR",
    "details": "Manual Bruno safety cancellation check.",
    "blockUser": false
  }
}

script:post-response {
  const body = res.getBody();
  if (body.chat.status !== "CANCELLED") {
    throw new Error(`Expected second chat CANCELLED, got ${body.chat.status}`);
  }
  if (body.exitRequest.type !== "SAFETY_REPORT") {
    throw new Error(`Expected SAFETY_REPORT exit request, got ${body.exitRequest.type}`);
  }
  if (body.penaltyApplied !== false) {
    throw new Error("Safety cancellation should not apply a penalty before admin confirmation.");
  }
  if (body.penalizedUserId !== null) {
    throw new Error("Safety cancellation should not return a penalized user before admin confirmation.");
  }
}
