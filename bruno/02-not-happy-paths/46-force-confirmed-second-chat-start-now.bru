meta {
  name: 46 Force Confirmed Second Chat Start Now
  type: http
  seq: 46
}

post {
  url: {{baseUrl}}/api/local-dev/timeouts/connections/{{negativeConnectionId}}/second-chat-available-now
  body: none
  auth: none
}

script:post-response {
  if (res.getBody().target !== "schedule-negotiation") {
    throw new Error("Expected dev timeout mutation for schedule-negotiation.");
  }
}
