meta {
  name: 10 Get Me New Before Provision Should Fail
  type: http
  seq: 11
}

get {
  url: {{baseUrl}}/api/me
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{firebase_new_id_token}}
  X-Firebase-AppCheck: {{firebase_app_check_token}}
}

script:post-response {
  if (res.getStatus() !== 403) {
    throw new Error(`Expected 403 Forbidden before backend provisioning, got ${res.getStatus()}`);
  }
  
  const body = res.getBody();
  if (!body || body.code !== "ACCESS_DENIED") {
    throw new Error(`Expected ACCESS_DENIED, got ${body && body.code}`);
  }
}
