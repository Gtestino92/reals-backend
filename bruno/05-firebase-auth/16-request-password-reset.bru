meta {
  name: 16 Request Password Reset
  type: http
  seq: 17
}

post {
  url: {{baseUrl}}/api/auth/password-reset
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{firebase_email}}"
  }
}

script:post-response {
  const status = res.getStatus();
  if (status !== 202) {
    throw new Error(`Expected generic 202 Accepted password reset response, got ${status}.`);
  }
}
