meta {
  name: 01 Provision Firebase User
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/me/provision
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{firebase_id_token}}
  X-Firebase-AppCheck: {{firebase_app_check_token}}
}

script:post-response {
  const status = res.getStatus();
  if (status !== 200 && status !== 201) {
    throw new Error(`Expected 200 OK or 201 Created, got ${status}`);
  }
  
  const body = res.getBody();
  if (!body || !body.id) {
    throw new Error("Expected provisioned backend user response with id.");
  }
  const expectedEmail = bru.getEnvVar("firebase_email");
  if (body.email !== expectedEmail) {
    throw new Error(`Expected Firebase user email ${expectedEmail}, got ${body.email}`);
  }
  if (body.passwordManagementAllowed !== true) {
    throw new Error(`Expected passwordManagementAllowed true for email/password Firebase flow, got ${body.passwordManagementAllowed}.`);
  }
  if (Object.prototype.hasOwnProperty.call(body, "authOrigin") && body.authOrigin !== "EMAIL_PASSWORD") {
    throw new Error(`Expected authOrigin EMAIL_PASSWORD when exposed, got ${body.authOrigin}.`);
  }
  
  bru.setEnvVar("firebaseUserId", body.id);
}
