meta {
  name: 04 Upload Profile Photo
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/me/profile/photos
  body: multipartForm
  auth: none
}

headers {
  Authorization: Bearer {{firebase_id_token}}
  X-Firebase-AppCheck: {{firebase_app_check_token}}
}

body:multipart-form {
  position: 1
  file: @file({{profile_photo_file_path}})
  ~isPersonPhoto: true
  ~isFullBody: false
}
