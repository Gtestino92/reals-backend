meta {
  name: 12 Get Me New Firebase User
  type: http
  seq: 13
}

get {
  url: {{baseUrl}}/api/me
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{firebase_new_id_token}}
  X-Firebase-AppCheck: {{firebase_app_check_token}}
}

script:post-response {
  const body = res.getBody();
  if (!body || !body.id) {
    throw new Error("Expected backend user response with id.");
  }
  
  const expectedEmail = bru.getEnvVar("firebase_new_email");
  if (body.email !== expectedEmail) {
    throw new Error(`Expected backend user email ${expectedEmail}, got ${body.email}`);
  }
  if (body.passwordManagementAllowed !== true) {
    throw new Error(`Expected passwordManagementAllowed true for email/password Firebase flow, got ${body.passwordManagementAllowed}.`);
  }
  if (Object.prototype.hasOwnProperty.call(body, "authOrigin") && body.authOrigin !== "EMAIL_PASSWORD") {
    throw new Error(`Expected authOrigin EMAIL_PASSWORD when exposed, got ${body.authOrigin}.`);
  }
  
  bru.setEnvVar("firebase_new_backend_user_id", body.id);
}
