meta {
  name: 28 User B Approve First Chat For Visual Timeout
  type: http
  seq: 28
}

post {
  url: {{baseUrl}}/api/matches/{{timeoutVisualMatchId}}/chat-decision
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Dev-User-Id: {{timeoutUserBId}}
}

body:json {
  {
    "decision": "APPROVED"
  }
}

script:post-response {
  if (res.getBody().state !== "VISUAL_PHASE") {
    throw new Error("Expected match to enter VISUAL_PHASE.");
  }
}
