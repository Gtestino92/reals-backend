meta {
  name: Run Second Chat Scheduling Activation Job
  type: http
  seq: 52
}

post {
  url: {{baseUrl}}/api/local-dev/jobs/scheduling-activation/run
  body: none
  auth: none
}

script:post-response {
  if (res.getBody().job !== "SchedulingActivationJob") {
    throw new Error("Expected SchedulingActivationJob to run.");
  }
}
