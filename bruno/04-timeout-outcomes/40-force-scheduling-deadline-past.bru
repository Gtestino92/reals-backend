meta {
  name: 40 Force Scheduling Deadline Past
  type: http
  seq: 40
}

post {
  url: {{baseUrl}}/api/local-dev/timeouts/connections/{{timeoutSchedulingConnectionId}}/scheduling-expire-now
  body: none
  auth: none
}

script:post-response {
  if (res.getBody().target !== "connection") {
    throw new Error("Expected dev timeout mutation for connection.");
  }
}
