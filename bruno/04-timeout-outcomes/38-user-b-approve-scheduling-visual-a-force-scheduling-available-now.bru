meta {
  name: Force Scheduling Available Now
  type: http
  seq: 38
}

post {
  url: {{baseUrl}}/api/local-dev/timeouts/connections/{{timeoutSchedulingConnectionId}}/scheduling-available-now
  body: none
  auth: none
}

script:post-response {
  const body = res.getBody();
  if (body.target !== "connection-scheduling-availability") {
    throw new Error("Expected dev timeout mutation for connection scheduling availability.");
  }
}
