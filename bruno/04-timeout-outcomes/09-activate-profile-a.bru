meta {
  name: 09 Activate Profile A
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/me/profile/activation
  body: none
  auth: none
}

headers {
  X-Dev-User-Id: {{timeoutUserAId}}
}

script:post-response {
  if (res.getBody().status !== "ACTIVE") {
    throw new Error("Expected profile A to be ACTIVE.");
  }
}
