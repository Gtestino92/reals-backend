meta {
  name: 18 Get First Chat Before Timeout
  type: http
  seq: 18
}

get {
  url: {{baseUrl}}/api/matches/{{timeoutFirstChatMatchId}}/chat
  body: none
  auth: none
}

headers {
  X-Dev-User-Id: {{timeoutUserAId}}
}

script:post-response {
  const body = res.getBody();
  if (body.status !== "ACTIVE") {
    throw new Error(`Expected first chat ACTIVE before timeout, got ${body.status}`);
  }
  bru.setEnvVar("timeoutFirstChatId", body.id);
}
