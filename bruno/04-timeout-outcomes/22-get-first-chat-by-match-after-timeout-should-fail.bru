meta {
  name: 22 Get First Chat By Match After Timeout Should Fail
  type: http
  seq: 22
}

get {
  url: {{baseUrl}}/api/matches/{{timeoutFirstChatMatchId}}/chat
  body: none
  auth: none
}

headers {
  X-Dev-User-Id: {{timeoutUserAId}}
}

script:post-response {
  if (res.getStatus() !== 409) {
    throw new Error(`Expected 409 because first chat is no longer active, got ${res.getStatus()}`);
  }
}
