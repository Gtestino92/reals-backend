meta {
  name: 38 User B Approve Scheduling Visual
  type: http
  seq: 38
}

post {
  url: {{baseUrl}}/api/matches/{{timeoutSchedulingMatchId}}/visual-decision
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Dev-User-Id: {{timeoutUserBId}}
}

body:json {
  {
    "decision": "APPROVED"
  }
}

script:post-response {
  const body = res.getBody();
  if (body.state !== "VISUAL_APPROVED" || !body.connectionId) {
    throw new Error("Expected VISUAL_APPROVED with connectionId.");
  }
  bru.setEnvVar("timeoutSchedulingConnectionId", body.connectionId);
}
