meta {
  name: 00 Setup Timeout Run Variables
  type: http
  seq: 0
}

get {
  url: {{baseUrl}}/api/ping
  body: none
  auth: none
}

script:pre-request {
  const clearEnvVars = (names) => names.forEach((name) => bru.setEnvVar(name, ""));
  clearEnvVars([
    "timeoutRunId",
    "timeoutUserAEmail",
    "timeoutUserBEmail",
    "timeoutSecondChatSlot",
    "timeoutUserAId",
    "timeoutUserBId",
    "timeoutProfileAId",
    "timeoutProfileBId",
    "timeoutFirstChatMatchId",
    "timeoutFirstChatId",
    "timeoutVisualMatchId",
    "timeoutSchedulingMatchId",
    "timeoutSchedulingConnectionId",
    "timeoutSecondChatMatchId",
    "timeoutSecondChatConnectionId",
    "timeoutSecondChatId"
  ]);

  const runId = Date.now().toString();
  const futureHalfHourSlot = (daysAhead, slotOffset) => {
    const hoursAhead = daysAhead * 24 + slotOffset;
    const date = new Date(Date.now() + hoursAhead * 60 * 60 * 1000);
    date.setUTCSeconds(0, 0);
    if (date.getUTCMinutes() < 30) {
      date.setUTCMinutes(30);
    } else {
      date.setUTCHours(date.getUTCHours() + 1, 0, 0, 0);
    }
    return date.toISOString();
  };

  bru.setEnvVar("timeoutRunId", runId);
  bru.setEnvVar("timeoutUserAEmail", `timeout.a.${runId}@example.com`);
  bru.setEnvVar("timeoutUserBEmail", `timeout.b.${runId}@example.com`);
  bru.setEnvVar("timeoutSecondChatSlot", futureHalfHourSlot(2, 0));
}

script:post-response {
  const body = res.getBody();
  if (!body || body.status !== "ok") {
    throw new Error("Expected ping response { status: 'ok' }");
  }
}
