meta {
  name: 03 Android Get Me
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/me
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{firebase_id_token}}
  X-Firebase-AppCheck: {{firebase_app_check_token}}
}

script:post-response {
  const body = res.getBody();
  if (!body || !body.id) {
    throw new Error("Expected authenticated user response with id.");
  }

  bru.setEnvVar("firebaseUserId", body.id);
  bru.setEnvVar("androidUserId", body.id);
  bru.setEnvVar("reliabilityUserId", body.id);
}

