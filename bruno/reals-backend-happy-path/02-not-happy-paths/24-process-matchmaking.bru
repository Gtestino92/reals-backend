meta {
  name: 24 Process Matchmaking
  type: http
  seq: 24
}

post {
  url: {{baseUrl}}/api/dev/matchmaking/process?maxPairsPerRun=1
  body: none
  auth: none
}

script:post-response {
  const body = res.getBody();
  if (!body || body.matchesCreated < 1 || !body.pairs || !body.pairs[0]) {
    throw new Error("Expected one match to be created.");
  }
  const match = body.pairs[0];
  bru.setEnvVar("negativeMatchId", match.id);
}
