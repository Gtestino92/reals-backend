meta {
  name: 02 Create Draft Profile
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/me/profile
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Dev-User-Id: {{negativeDraftUserId}}
}

body:json {
  {
    "displayName": "Draft Negative",
    "birthDate": "1996-01-01",
    "gender": "FEMALE",
    "lookingForGenders": ["MALE"],
    "intention": "DATE",
    "city": "Buenos Aires",
    "countryCode": "AR",
    "bio": "Draft profile for negative tests.",
    "preferredMinAge": 18,
    "preferredMaxAge": 99,
    "maxDistanceKm": 50
  }
}

script:post-response {
  const body = res.getBody();
  if (!body || !body.id) {
    throw new Error("Expected created draft profile id.");
  }
  if (!body.userId) {
    throw new Error("Expected created draft profile userId.");
  }
  bru.setEnvVar("negativeDraftUserId", body.userId);
  bru.setEnvVar("negativeDraftProfileId", body.id);
}
