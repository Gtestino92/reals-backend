meta {
  name: 43 Force Confirmed Second Chat Start Now
  type: http
  seq: 43
}

post {
  url: {{baseUrl}}/api/dev/timeouts/connections/{{negativeConnectionId}}/second-chat-start-now
  body: none
  auth: none
}

script:post-response {
  if (res.getBody().target !== "schedule-negotiation") {
    throw new Error("Expected dev timeout mutation for schedule-negotiation.");
  }
}
