meta {
  name: 37 Stranger Add Proposal Should Fail
  type: http
  seq: 37
}

post {
  url: {{baseUrl}}/api/connections/{{negativeConnectionId}}/proposals
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Dev-User-Id: {{negativeStrangerUserId}}
}

body:json {
  {
    "proposedDateTimes": ["{{negativeSecondChatDateTime}}"]
  }
}

script:post-response {
  if (res.getStatus() !== 409) {
    throw new Error(`Expected 409 Conflict, got ${res.getStatus()}`);
  }
}
