meta {
  name: 42 Add Proposal After Confirmed Should Fail
  type: http
  seq: 42
}

post {
  url: {{baseUrl}}/api/connections/{{negativeConnectionId}}/proposals
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Dev-User-Id: {{negativeUserAId}}
}

body:json {
  {
    "proposedDateTime": "{{negativeSecondChatDateTime}}"
  }
}

script:post-response {
  if (res.getStatus() !== 409) {
    throw new Error(`Expected 409 Conflict, got ${res.getStatus()}`);
  }
}
