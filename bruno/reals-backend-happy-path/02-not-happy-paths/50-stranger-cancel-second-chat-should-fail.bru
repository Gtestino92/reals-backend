meta {
  name: 50 Stranger Cancel Second Chat Should Fail
  type: http
  seq: 50
}

post {
  url: {{baseUrl}}/api/chats/{{negativeSecondChatId}}/cancellations
  body: json
  auth: none
}

headers {
  X-Dev-User-Id: {{negativeStrangerUserId}}
}

body:json {
  {
    "reason": "NO_LONGER_INTERESTED",
    "details": "Stranger cannot cancel a chat they do not belong to."
  }
}

script:post-response {
  if (res.getStatus() !== 409) {
    throw new Error(`Expected 409 Conflict, got ${res.getStatus()}`);
  }
}
