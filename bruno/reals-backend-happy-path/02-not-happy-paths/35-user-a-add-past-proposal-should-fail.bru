meta {
  name: 35 User A Add Past Proposal Should Fail
  type: http
  seq: 35
}

post {
  url: {{baseUrl}}/api/connections/{{negativeConnectionId}}/proposals
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Dev-User-Id: {{negativeUserAId}}
}

body:json {
  {
    "proposedDateTime": "2000-01-01T00:00:00Z"
  }
}

script:post-response {
  if (res.getStatus() !== 409) {
    throw new Error(`Expected 409 Conflict, got ${res.getStatus()}`);
  }
}
