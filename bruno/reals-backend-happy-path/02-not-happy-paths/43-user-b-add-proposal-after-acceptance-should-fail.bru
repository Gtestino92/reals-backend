meta {
  name: 43 User B Add Proposal After Acceptance Should Fail
  type: http
  seq: 43
}

post {
  url: {{baseUrl}}/api/connections/{{negativeConnectionId}}/proposals
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Dev-User-Id: {{negativeUserBId}}
}

body:json {
  {
    "proposedDateTimes": ["{{negativeOtherSecondChatDateTime}}"]
  }
}

script:post-response {
  if (res.getStatus() !== 409) {
    throw new Error(`Expected 409 Conflict, got ${res.getStatus()}`);
  }
}
