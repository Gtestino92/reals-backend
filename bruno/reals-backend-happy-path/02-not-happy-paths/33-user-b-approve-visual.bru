meta {
  name: 33 User B Approve Visual
  type: http
  seq: 33
}

post {
  url: {{baseUrl}}/api/matches/{{negativeMatchId}}/visual-decision
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Dev-User-Id: {{negativeUserBId}}
}

body:json {
  {
    "decision": "APPROVED"
  }
}

script:post-response {
  const body = res.getBody();
  if (!body.connectionId) {
    throw new Error("Expected connectionId.");
  }
  bru.setEnvVar("negativeConnectionId", body.connectionId);
}
