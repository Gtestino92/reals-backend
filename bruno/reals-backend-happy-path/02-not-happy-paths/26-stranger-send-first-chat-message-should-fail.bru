meta {
  name: 26 Stranger Send First Chat Message Should Fail
  type: http
  seq: 26
}

post {
  url: {{baseUrl}}/api/chats/{{negativeFirstChatId}}/messages
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Dev-User-Id: {{negativeStrangerUserId}}
}

body:json {
  {
    "content": "I should not be allowed to send this."
  }
}

script:post-response {
  if (res.getStatus() !== 403) {
    throw new Error(`Expected 403 Forbidden, got ${res.getStatus()}`);
  }
  const body = res.getBody();
  if (!body || body.code !== "ACCESS_DENIED") {
    throw new Error(`Expected ACCESS_DENIED, got ${body && body.code}`);
  }
}
