meta {
  name: 09 Create Profile A
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/me/profile
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Dev-User-Id: {{negativeUserAId}}
}

body:json {
  {
    "displayName": "Negative A",
    "birthDate": "1996-03-14",
    "gender": "FEMALE",
    "lookingForGender": "MEN",
    "intention": "DATE",
    "city": "Buenos Aires",
    "country": "AR",
    "bio": "Negative path A.",
    "preferredMinAge": 18,
    "preferredMaxAge": 99,
    "maxDistanceKm": 50
  }
}

script:post-response {
  bru.setEnvVar("negativeProfileAId", res.getBody().id);
}
