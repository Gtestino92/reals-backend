meta {
  name: 49 Stranger Cancel First Chat Should Fail
  type: http
  seq: 49
}

post {
  url: {{baseUrl}}/api/chats/{{negativeFirstChatId}}/cancellations
  body: json
  auth: none
}

headers {
  X-Dev-User-Id: {{negativeStrangerUserId}}
}

body:json {
  {
    "reason": "NO_LONGER_INTERESTED",
    "details": "Stranger cannot cancel a chat they do not belong to."
  }
}

script:post-response {
  if (res.getStatus() !== 403) {
    throw new Error(`Expected 403 Forbidden, got ${res.getStatus()}`);
  }
  const body = res.getBody();
  if (!body || body.code !== "ACCESS_DENIED") {
    throw new Error(`Expected ACCESS_DENIED, got ${body && body.code}`);
  }
}
