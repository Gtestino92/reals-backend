meta {
  name: 08 Run Scheduling Timeout Job
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/local-dev/jobs/scheduling-timeout/run
  body: none
  auth: none
}

script:post-response {
  if (res.getBody().job !== "SchedulingNegotiationTimeoutJob") {
    throw new Error("Expected SchedulingNegotiationTimeoutJob to run.");
  }
}
