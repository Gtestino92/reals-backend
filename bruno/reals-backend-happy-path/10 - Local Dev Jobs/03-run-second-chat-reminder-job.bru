meta {
  name: 03 Run Second Chat Reminder Job
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/local-dev/jobs/second-chat-reminder/run
  body: none
  auth: none
}

script:post-response {
  if (res.getBody().job !== "SecondChatReminderNotificationJob") {
    throw new Error("Expected SecondChatReminderNotificationJob to run.");
  }
}

docs {
  Sends due confirmed second-chat reminders. The connection must still be SECOND_CHAT_SCHEDULED and confirmedDateTime must fall inside the configured reminder window.
}
