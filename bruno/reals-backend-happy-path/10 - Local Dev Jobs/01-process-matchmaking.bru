meta {
  name: 01 Process Matchmaking
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/local-dev/matchmaking/process?maxPairsPerRun=5
  body: none
  auth: none
}

docs {
  Local counterpart of MatchmakingJob.
}

script:post-response {
  const status = res.getStatus();
  if (status === 404 || status === 403) {
    throw new Error(
      `Expected local matchmaking process endpoint to be available, got ${status}. ` +
      `Make sure the backend is running with a local profile.`
    );
  }

  const body = res.getBody();
  if (!body || !Array.isArray(body.pairs) || body.pairs.length < 1) {
    throw new Error("No match was created. Make sure compatible active users are queued.");
  }

  const preferredUserIds = [
    bru.getEnvVar("androidUserId"),
    bru.getEnvVar("firebaseUserId"),
    bru.getEnvVar("userAId")
  ].filter((value) => value && !value.startsWith("paste-"));

  const match =
    body.pairs.find((candidate) =>
      preferredUserIds.length === 0 ||
      preferredUserIds.some((userId) => candidate.userAId === userId || candidate.userBId === userId)
    ) || body.pairs[0];

  bru.setEnvVar("matchId", match.id);
  bru.setEnvVar("matchParticipant1Id", match.userAId);
  bru.setEnvVar("matchParticipant2Id", match.userBId);
  bru.setEnvVar("matchUserAId", match.userAId);
  bru.setEnvVar("matchUserBId", match.userBId);
}
