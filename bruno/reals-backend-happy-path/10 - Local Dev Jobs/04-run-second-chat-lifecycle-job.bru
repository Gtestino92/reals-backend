meta {
  name: 04 Run Second Chat Lifecycle Job
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/local-dev/jobs/second-chat-lifecycle/run
  body: none
  auth: none
}

script:post-response {
  if (res.getBody().job !== "SecondChatLifecycleJob") {
    throw new Error("Expected SecondChatLifecycleJob to run.");
  }
}

docs {
  Handles scheduled second-chat availability/expiry, active second-chat expiry, read-only retention cleanup and related connection closure.
}
