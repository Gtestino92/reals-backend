meta {
  name: 04 Sign Up New Firebase User
  type: http
  seq: 4
}

post {
  url: https://identitytoolkit.googleapis.com/v1/accounts:signUp?key={{firebase_api_key}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{firebase_new_email}}",
    "password": "{{firebase_new_password}}",
    "returnSecureToken": true
  }
}

script:pre-request {
  const runId = Date.now().toString();
  bru.setEnvVar("firebase_new_run_id", runId);
  bru.setEnvVar("firebase_new_email", `firebase.new.${runId}@example.com`);
  bru.setEnvVar("firebase_new_password", "Password123!");
}

script:post-response {
  const body = res.getBody();
  if (!body || !body.idToken || !body.localId || !body.email) {
    throw new Error("Expected Firebase sign-up response with idToken, localId and email.");
  }

  const expectedEmail = bru.getEnvVar("firebase_new_email");
  if (body.email !== expectedEmail) {
    throw new Error(`Expected Firebase new email ${expectedEmail}, got ${body.email}`);
  }

  bru.setEnvVar("firebase_new_id_token", body.idToken);
  bru.setEnvVar("firebase_new_uid", body.localId);
}
