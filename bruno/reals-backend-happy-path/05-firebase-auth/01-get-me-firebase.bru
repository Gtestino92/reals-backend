meta {
  name: 01 Get Me Firebase
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/me
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{firebase_id_token}}
}

script:post-response {
  const body = res.getBody();
  if (!body || !body.id) {
    throw new Error("Expected authenticated user response with id.");
  }
  if (body.email !== "test@example.com") {
    throw new Error(`Expected Firebase user email test@example.com, got ${body.email}`);
  }
  bru.setEnvVar("firebaseUserId", body.id);
}
