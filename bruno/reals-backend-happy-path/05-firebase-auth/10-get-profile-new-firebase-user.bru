meta {
  name: 10 Get Profile New Firebase User
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/api/me/profile
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{firebase_new_id_token}}
}

script:post-response {
  const body = res.getBody();
  if (!body || !body.id) {
    throw new Error("Expected Firebase new user profile response with id.");
  }

  const expectedProfileId = bru.getEnvVar("firebase_new_profile_id");
  if (expectedProfileId && body.id !== expectedProfileId) {
    throw new Error(`Expected profile ${expectedProfileId}, got ${body.id}`);
  }

  bru.setEnvVar("firebase_new_profile_id", body.id);
}
