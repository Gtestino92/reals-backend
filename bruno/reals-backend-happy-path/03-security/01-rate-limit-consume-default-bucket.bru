meta {
  name: 01 Rate Limit Consume Default Bucket
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/local-dev/users
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "rate.limit.first.{{rateLimitRunId}}@example.com"
  }
}

script:pre-request {
  const runId = Date.now().toString();
  bru.setEnvVar("rateLimitRunId", runId);
}

script:post-response {
  if (res.status !== 201) {
    throw new Error(`Expected first rate-limit request to create a user, got ${res.status}.`);
  }

  const limit = res.getHeader("X-RateLimit-Limit");
  const remaining = res.getHeader("X-RateLimit-Remaining");
  if (!limit || remaining === undefined) {
    throw new Error("Expected rate-limit response headers.");
  }
}
