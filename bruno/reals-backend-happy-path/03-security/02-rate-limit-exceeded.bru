meta {
  name: 02 Rate Limit Exceeded
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/local-dev/users
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "rate.limit.second.{{rateLimitRunId}}@example.com"
  }
}

script:post-response {
  if (res.status !== 429) {
    throw new Error(
      `Expected 429. Start the backend with RATE_LIMIT_DEFAULT_CAPACITY=1, ` +
      `RATE_LIMIT_DEFAULT_REFILL_TOKENS=1 and RATE_LIMIT_DEFAULT_REFILL_PERIOD_SECONDS=60. Got ${res.status}.`
    );
  }

  const retryAfter = res.getHeader("Retry-After");
  if (!retryAfter) {
    throw new Error("Expected Retry-After header.");
  }

  const body = res.getBody();
  if (!body || body.code !== "RATE_LIMIT_EXCEEDED") {
    throw new Error("Expected RATE_LIMIT_EXCEEDED response body.");
  }
}
