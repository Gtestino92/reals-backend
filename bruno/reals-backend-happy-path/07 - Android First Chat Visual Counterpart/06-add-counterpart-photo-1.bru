meta {
  name: 06 Add Counterpart Photo 1
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/me/profile/photos
  body: multipartForm
  auth: none
}

headers {
  Authorization: Bearer {{firebase_counterpart_id_token}}
}

body:multipart-form {
  position: 1
  file: @file({{profile_photo_file_path}})
}
