meta {
  name: 18 Counterpart Add Visual Personal Message
  type: http
  seq: 22
}

put {
  url: {{baseUrl}}/api/matches/{{counterpartMatchId}}/personal-messages/me
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{firebase_counterpart_id_token}}
}

body:json {
  {
    "message": "Me gusto la charla. Sigamos con la etapa visualsss"
  }
}

script:post-response {
  if (res.status !== 204) {
    throw new Error(`Expected 204 after counterpart personal message, got ${res.status}. The Android user may still need to approve first chat.`);
  }
}
