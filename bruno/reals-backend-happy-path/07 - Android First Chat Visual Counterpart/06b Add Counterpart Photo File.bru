meta {
  name: 06b Get Counterpart Photos After Photo 1
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/api/me/profile/photos
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{firebase_counterpart_id_token}}
}

script:post-response {
  const body = res.getBody();
  if (!Array.isArray(body) || body.length < 1) {
    throw new Error("Expected at least one counterpart profile photo.");
  }
}
