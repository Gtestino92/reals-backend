meta {
  name: 06b Add Counterpart Photo File
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/me/profile/photos
  body: multipartForm
  auth: inherit
}

headers {
  Authorization: Bearer {{firebase_counterpart_id_token}}
  Content-Type: multipart/form-data
}

body:multipart-form {
  file: @file()
  position: 1
}

settings {
  encodeUrl: false
  timeout: 0
}
