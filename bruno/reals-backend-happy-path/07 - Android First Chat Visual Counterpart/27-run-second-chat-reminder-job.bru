meta {
  name: 27 Run Second Chat Reminder Job
  type: http
  seq: 33
}

post {
  url: {{baseUrl}}/api/local-dev/jobs/second-chat-reminder/run
  body: none
  auth: none
}

script:post-response {
  const body = res.getBody();
  if (body.job !== "SecondChatReminderNotificationJob") {
    throw new Error(`Expected SecondChatReminderNotificationJob to run, got: ${JSON.stringify(body)}`);
  }
}

docs {
  Run this after scheduling is CONFIRMED and the agreed secondChatDateTime is inside the configured reminder window. The connection must still be SECOND_CHAT_SCHEDULED; once it becomes SECOND_CHAT_AVAILABLE, reminders are intentionally skipped.
}
