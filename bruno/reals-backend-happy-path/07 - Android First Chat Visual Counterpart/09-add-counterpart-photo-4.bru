meta {
  name: 09 Add Counterpart Photo 4
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/api/me/profile/photos
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{firebase_counterpart_id_token}}
}

body:json {
  {
    "url": "https://example.com/android-counterpart-{{counterpartRunId}}-4.jpg",
    "position": 4,
    "isPersonPhoto": false,
    "isFullBody": false
  }
}
