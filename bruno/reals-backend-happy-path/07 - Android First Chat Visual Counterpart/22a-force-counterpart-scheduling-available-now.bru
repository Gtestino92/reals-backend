meta {
  name: 22a Force Counterpart Scheduling Available Now
  type: http
  seq: 27
}

post {
  url: {{baseUrl}}/api/local-dev/timeouts/connections/{{counterpartConnectionId}}/scheduling-available-now
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{firebase_counterpart_id_token}}
}

script:post-response {
  const body = res.getBody();
  if (body.target !== "connection-scheduling-availability") {
    throw new Error("Expected dev timeout mutation for counterpart connection scheduling availability.");
  }
}
