meta {
  name: 03 Create Counterpart Profile
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/me/profile
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{firebase_counterpart_id_token}}
}

body:json {
  {
    "displayName": "Counterpart Firebase",
    "birthDate": "1995-05-10",
    "gender": "MALE",
    "lookingForGender": "WOMEN",
    "intention": "DATE",
    "city": "Buenos Aires",
    "country": "AR",
    "bio": "Usuario Firebase generado desde Bruno para probar primer chat y review visual.",
    "preferredMinAge": 18,
    "preferredMaxAge": 99,
    "maxDistanceKm": 50
  }
}

script:post-response {
  const body = res.getBody();
  if (!body || !body.id) {
    throw new Error("Expected counterpart profile id.");
  }
  bru.setEnvVar("counterpartProfileId", body.id);
}
