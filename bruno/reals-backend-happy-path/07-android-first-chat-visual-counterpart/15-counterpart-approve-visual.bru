meta {
  name: 15 Counterpart Approve Visual
  type: http
  seq: 15
}

post {
  url: {{baseUrl}}/api/matches/{{counterpartMatchId}}/visual-decision
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Dev-User-Id: {{counterpartUserId}}
}

body:json {
  {
    "decision": "APPROVED"
  }
}

script:post-response {
  const body = res.getBody();
  if (!body || (body.state !== "VISUAL_PHASE" && body.state !== "VISUAL_APPROVED")) {
    throw new Error(`Expected VISUAL_PHASE or VISUAL_APPROVED after counterpart visual approval, got ${body && body.state}.`);
  }
  if (body.connectionId) {
    bru.setEnvVar("counterpartConnectionId", body.connectionId);
  }
}
