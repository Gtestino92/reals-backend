meta {
  name: 04 Add Counterpart Photo 2
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/me/profile/photos
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Dev-User-Id: {{counterpartUserId}}
}

body:json {
  {
    "url": "https://example.com/android-counterpart-{{counterpartRunId}}-2.jpg",
    "position": 2,
    "isPersonPhoto": false,
    "isFullBody": false
  }
}
