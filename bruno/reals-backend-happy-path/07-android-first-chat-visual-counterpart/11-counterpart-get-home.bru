meta {
  name: 11 Counterpart Get Home
  type: http
  seq: 13
}

get {
  url: {{baseUrl}}/api/me/home
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{firebase_counterpart_id_token}}
}

script:post-response {
  const body = res.getBody();
  if (!body || !body.activeMatches || !body.activeMatches[0]) {
    throw new Error("Expected counterpart active match in home response.");
  }
  
  const active = body.activeMatches.find((m) => m.matchId === bru.getEnvVar("counterpartMatchId")) || body.activeMatches[0];
  bru.setEnvVar("counterpartMatchId", active.matchId);
  if (active.firstChat && active.firstChat.chatId) {
    bru.setEnvVar("counterpartFirstChatId", active.firstChat.chatId);
  }
}
