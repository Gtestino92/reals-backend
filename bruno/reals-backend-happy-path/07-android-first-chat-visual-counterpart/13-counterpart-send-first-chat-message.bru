meta {
  name: 13 Counterpart Send First Chat Message
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/api/chats/{{counterpartFirstChatId}}/messages
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{firebase_counterpart_id_token}}
}

body:json {
  {
    "content": "Mensaje desde Bruno para simular a la otra persona en el primer chat."
  }
}
