meta {
  name: 01c Sign In Firebase ME
  type: http
  seq: 4
}

post {
  url: https://identitytoolkit.googleapis.com/v1/accounts:signInWithPassword?key={{firebase_api_key}}
  body: json
  auth: none
}

params:query {
  key: {{firebase_api_key}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "roger@test.com",
    "password": "federer92",
    "returnSecureToken": true
  }
}

script:post-response {
  const body = res.getBody();
  if (!body || !body.idToken || !body.localId || !body.email) {
    throw new Error("Expected Firebase sign-up response with idToken, localId and email.");
  }
  
  bru.setEnvVar("firebase_counterpart_id_token", body.idToken);
  bru.setEnvVar("firebase_counterpart_uid", body.localId);
}
