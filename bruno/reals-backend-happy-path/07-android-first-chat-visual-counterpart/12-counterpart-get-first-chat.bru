meta {
  name: 12 Counterpart Get First Chat
  type: http
  seq: 14
}

get {
  url: {{baseUrl}}/api/matches/{{counterpartMatchId}}/chat
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{firebase_counterpart_id_token}}
}

script:post-response {
  const body = res.getBody();
  if (!body || !body.id || body.chatType !== "FIRST_CHAT") {
    throw new Error("Expected active first chat for counterpart.");
  }
  bru.setEnvVar("counterpartFirstChatId", body.id);
}
