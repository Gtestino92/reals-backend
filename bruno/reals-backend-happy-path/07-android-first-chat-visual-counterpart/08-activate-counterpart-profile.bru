meta {
  name: 08 Activate Counterpart Profile
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/me/profile/activation
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{firebase_counterpart_id_token}}
}

script:post-response {
  const body = res.getBody();
  if (!body || body.status !== "ACTIVE") {
    throw new Error(`Expected counterpart profile ACTIVE, got ${body && body.status}.`);
  }
}
