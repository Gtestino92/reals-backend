meta {
  name: 08 Enqueue Counterpart And Process Matchmaking
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/matchmaking/queue
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Dev-User-Id: {{counterpartUserId}}
}

body:json {
  {
    "latitude": -34.6037,
    "longitude": -58.3816,
    "accuracyMeters": 50
  }
}

script:post-response {
  const body = res.getBody();
  if (!body || body.inQueue !== true) {
    throw new Error("Expected counterpart to enter queue.");
  }
}
