meta {
  name: 00 Setup Reliability Debug Run
  type: http
  seq: 0
}

get {
  url: {{baseUrl}}/api/ping
  body: none
  auth: none
}

script:pre-request {
  const clearEnvVars = (names) => names.forEach((name) => bru.setEnvVar(name, ""));
  clearEnvVars([
    "reliabilityRunId",
    "reliabilityUserId",
    "reliabilityAndroidEffectiveScore",
    "reliabilityAndroidEventCount",
    "reliabilityCounterpartEffectiveScore",
    "reliabilityCounterpartEventCount",
    "firebase_id_token",
    "firebase_uid",
    "firebaseUserId",
    "androidUserId",
    "firebase_counterpart_id_token",
    "firebase_counterpart_uid",
    "counterpartUserId"
  ]);

  const runId = Date.now().toString();
  bru.setEnvVar("reliabilityRunId", runId);
  if (!bru.getEnvVar("firebase_email")) {
    throw new Error("Set firebase_email in ignored local.bru before running Firebase reliability debug.");
  }
  if (!bru.getEnvVar("firebase_password")) {
    throw new Error("Set firebase_password in ignored local.bru before running Firebase reliability debug.");
  }
  if (!bru.getEnvVar("firebase_counterpart_email")) {
    bru.setEnvVar("firebase_counterpart_email", "android.counterpart@example.com");
  }
  if (!bru.getEnvVar("firebase_counterpart_password")) {
    throw new Error("Set firebase_counterpart_password in ignored local.bru before running Firebase reliability debug.");
  }
}

script:post-response {
  const body = res.getBody();
  if (!body || body.status !== "ok") {
    throw new Error("Expected ping response { status: 'ok' }");
  }
}
