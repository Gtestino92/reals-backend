meta {
  name: 05 Invalid Age Range Should Fail
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/api/me/profile/match-filters
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Dev-User-Id: {{dynamicFiltersUserId}}
}

body:json {
  {
    "lookingForGenders": ["MALE"],
    "preferredMinAge": 45,
    "preferredMaxAge": 30,
    "maxDistanceKm": 20
  }
}

script:post-response {
  if (res.getStatus() !== 400) {
    throw new Error(`Expected 400 Bad Request, got ${res.getStatus()}`);
  }
}
