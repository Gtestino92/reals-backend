meta {
  name: 00 Setup Dynamic Match Filters
  type: http
  seq: 0
}

get {
  url: {{baseUrl}}/api/ping
  body: none
  auth: none
}

script:pre-request {
  const clearEnvVars = (names) => names.forEach((name) => bru.setEnvVar(name, ""));
  clearEnvVars([
    "dynamicFiltersRunId",
    "dynamicFiltersUserEmail",
    "dynamicFiltersUserId",
    "dynamicFiltersProfileId"
  ]);

  const runId = Date.now().toString();
  bru.setEnvVar("dynamicFiltersRunId", runId);
  bru.setEnvVar("dynamicFiltersUserEmail", `dynamic.filters.${runId}@example.com`);
}

script:post-response {
  const body = res.getBody();
  if (!body || body.status !== "ok") {
    throw new Error("Expected ping response { status: 'ok' }");
  }
}
