meta {
  name: 29 Force Visual Deadline Past
  type: http
  seq: 29
}

post {
  url: {{baseUrl}}/api/local-dev/timeouts/matches/{{timeoutVisualMatchId}}/visual-expire-now
  body: none
  auth: none
}

script:post-response {
  if (res.getBody().target !== "visual-review") {
    throw new Error("Expected dev timeout mutation for visual-review.");
  }
}
