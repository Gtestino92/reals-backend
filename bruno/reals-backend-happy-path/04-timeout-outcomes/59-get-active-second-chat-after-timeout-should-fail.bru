meta {
  name: 59 Get Active Second Chat After Timeout Should Fail
  type: http
  seq: 59
}

get {
  url: {{baseUrl}}/api/connections/{{timeoutSecondChatConnectionId}}/chat
  body: none
  auth: none
}

script:post-response {
  if (res.getStatus() !== 409) {
    throw new Error(`Expected 409 because second chat is no longer active, got ${res.getStatus()}`);
  }
}
