meta {
  name: 54 User B Propose Same Second Chat Slot
  type: http
  seq: 54
}

post {
  url: {{baseUrl}}/api/connections/{{timeoutSecondChatConnectionId}}/proposals
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Dev-User-Id: {{timeoutUserBId}}
}

body:json {
  {
    "expectedRoundNumber": 1,
    "proposedDateTimes": ["{{timeoutSecondChatSlot}}"]
  }
}

script:post-response {
  const body = res.getBody();
  if (body.some((proposal) => proposal.chatId)) {
    throw new Error("Second chat should not start immediately after scheduling confirmation.");
  }
}
