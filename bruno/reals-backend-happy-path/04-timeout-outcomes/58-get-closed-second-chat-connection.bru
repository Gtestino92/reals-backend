meta {
  name: 58 Get Closed Second Chat Connection
  type: http
  seq: 58
}

get {
  url: {{baseUrl}}/api/connections/{{timeoutSecondChatConnectionId}}
  body: none
  auth: none
}

script:post-response {
  if (res.getBody().state !== "CLOSED") {
    throw new Error(`Expected second chat connection CLOSED, got ${res.getBody().state}`);
  }
}
