meta {
  name: 31 Get Expired Visual Match
  type: http
  seq: 31
}

get {
  url: {{baseUrl}}/api/matches/{{timeoutVisualMatchId}}
  body: none
  auth: none
}

script:post-response {
  const body = res.getBody();
  if (body.state !== "EXPIRED") {
    throw new Error(`Expected visual match EXPIRED, got ${body.state}`);
  }
  if (body.connectionId) {
    throw new Error("Expired visual phase must not create a connection.");
  }
}
