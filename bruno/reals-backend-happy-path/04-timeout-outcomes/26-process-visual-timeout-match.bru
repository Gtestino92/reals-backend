meta {
  name: 26 Process Visual Timeout Match
  type: http
  seq: 26
}

post {
  url: {{baseUrl}}/api/dev/matchmaking/process?batchSize=1
  body: none
  auth: none
}

script:post-response {
  const body = res.getBody();
  if (!body || body.matchesCreated !== 1 || !body.pairs || !body.pairs[0]) {
    throw new Error("Expected one match for visual timeout.");
  }
  bru.setEnvVar("timeoutVisualMatchId", body.pairs[0].id);
}
