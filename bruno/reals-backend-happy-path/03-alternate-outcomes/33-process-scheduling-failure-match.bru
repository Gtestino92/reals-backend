meta {
  name: 33 Process Scheduling Failure Match
  type: http
  seq: 33
}

post {
  url: {{baseUrl}}/api/local-dev/matchmaking/process?maxPairsPerRun=1
  body: none
  auth: none
}

script:post-response {
  const body = res.getBody();
  if (!body || body.matchesCreated !== 1 || !body.pairs || !body.pairs[0]) {
    throw new Error("Expected exactly one match for scheduling failure scenario.");
  }

  bru.setEnvVar("alternateMatchSchedulingFailedId", body.pairs[0].id);
}
