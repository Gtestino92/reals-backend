meta {
  name: 60 Process Mutual Cancel Match
  type: http
  seq: 60
}

post {
  url: {{baseUrl}}/api/dev/matchmaking/process?maxPairsPerRun=1
  body: none
  auth: none
}

script:post-response {
  const body = res.getBody();
  if (!body || body.matchesCreated !== 1 || !body.pairs || !body.pairs[0]) {
    throw new Error("Expected exactly one match for mutual cancellation scenario.");
  }

  bru.setEnvVar("alternateMutualCancelMatchId", body.pairs[0].id);
}
