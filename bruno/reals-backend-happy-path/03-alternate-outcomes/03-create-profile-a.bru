meta {
  name: 03 Create Profile A
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/me/profile
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Dev-User-Id: {{alternateUserAId}}
}

body:json {
  {
    "displayName": "Alternate A",
    "birthDate": "1996-03-14",
    "gender": "FEMALE",
    "lookingForGender": "MEN",
    "intention": "DATE",
    "city": "Buenos Aires",
    "country": "AR",
    "bio": "Alternate outcomes A."
  }
}

script:post-response {
  bru.setEnvVar("alternateProfileAId", res.getBody().id);
}
