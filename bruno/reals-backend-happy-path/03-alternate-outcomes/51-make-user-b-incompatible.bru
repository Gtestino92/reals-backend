meta {
  name: 51 Make User B Incompatible
  type: http
  seq: 51
}

patch {
  url: {{baseUrl}}/api/me/profile
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Dev-User-Id: {{alternateUserBId}}
}

body:json {
  {
    "lookingForGender": "MEN"
  }
}

script:post-response {
  const body = res.getBody();
  if (body.lookingForGender !== "MEN") {
    throw new Error(`Expected user B lookingForGender MEN, got ${body.lookingForGender}`);
  }
}
