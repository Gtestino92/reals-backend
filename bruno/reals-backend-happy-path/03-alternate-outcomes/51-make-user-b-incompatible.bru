meta {
  name: 51 Make User B Incompatible
  type: http
  seq: 51
}

patch {
  url: {{baseUrl}}/api/me/profile
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Dev-User-Id: {{alternateUserBId}}
}

body:json {
  {
    "lookingForGenders": ["MALE"]
  }
}

script:post-response {
  const body = res.getBody();
  if (JSON.stringify(body.lookingForGenders) !== JSON.stringify(["MALE"])) {
    throw new Error(`Expected user B lookingForGenders [MALE], got ${body.lookingForGenders}`);
  }
}
