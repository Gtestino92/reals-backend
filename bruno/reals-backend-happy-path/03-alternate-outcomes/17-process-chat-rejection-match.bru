meta {
  name: 17 Process Chat Rejection Match
  type: http
  seq: 17
}

post {
  url: {{baseUrl}}/api/dev/matchmaking/process?batchSize=1
  body: none
  auth: none
}

script:post-response {
  const body = res.getBody();
  if (!body || body.matchesCreated !== 1 || !body.pairs || !body.pairs[0]) {
    throw new Error("Expected exactly one match for chat rejection scenario.");
  }

  bru.setEnvVar("alternateMatchChatRejectedId", body.pairs[0].id);
}
