meta {
  name: 57 Restore User B Compatibility
  type: http
  seq: 57
}

patch {
  url: {{baseUrl}}/api/me/profile
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Dev-User-Id: {{alternateUserBId}}
}

body:json {
  {
    "lookingForGenders": ["FEMALE"]
  }
}

script:post-response {
  const body = res.getBody();
  if (JSON.stringify(body.lookingForGenders) !== JSON.stringify(["FEMALE"])) {
    throw new Error(`Expected user B lookingForGenders [FEMALE], got ${body.lookingForGenders}`);
  }
}
