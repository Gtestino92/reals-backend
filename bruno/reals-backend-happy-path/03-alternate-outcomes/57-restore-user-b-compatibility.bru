meta {
  name: 57 Restore User B Compatibility
  type: http
  seq: 57
}

patch {
  url: {{baseUrl}}/api/me/profile
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Dev-User-Id: {{alternateUserBId}}
}

body:json {
  {
    "lookingForGender": "WOMEN"
  }
}

script:post-response {
  const body = res.getBody();
  if (body.lookingForGender !== "WOMEN") {
    throw new Error(`Expected user B lookingForGender WOMEN, got ${body.lookingForGender}`);
  }
}
