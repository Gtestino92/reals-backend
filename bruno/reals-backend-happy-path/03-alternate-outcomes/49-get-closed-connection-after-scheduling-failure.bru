meta {
  name: 49 Get Closed Connection After Scheduling Failure
  type: http
  seq: 49
}

get {
  url: {{baseUrl}}/api/connections/{{alternateConnectionSchedulingFailedId}}
  body: none
  auth: none
}

headers {
  X-Dev-User-Id: {{alternateUserAId}}
}

script:post-response {
  const body = res.getBody();
  if (body.state !== "CLOSED") {
    throw new Error(`Expected CLOSED connection after failed negotiation, got ${body.state}`);
  }
}
