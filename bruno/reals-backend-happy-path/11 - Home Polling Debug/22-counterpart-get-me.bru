meta {
  name: 22 Counterpart Get Me
  type: http
  seq: 22
}

get {
  url: {{baseUrl}}/api/me
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{firebase_counterpart_id_token}}
}

script:post-response {
  const body = res.getBody();
  if (!body || !body.id) {
    throw new Error("Expected authenticated counterpart user response with id.");
  }

  bru.setEnvVar("counterpartUserId", body.id);
}
