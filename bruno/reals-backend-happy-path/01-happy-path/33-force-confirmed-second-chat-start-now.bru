meta {
  name: 33 Force Confirmed Second Chat Start Now
  type: http
  seq: 33
}

post {
  url: {{baseUrl}}/api/dev/timeouts/connections/{{connectionId}}/second-chat-start-now
  body: none
  auth: none
}

script:post-response {
  const body = res.getBody();
  if (body.target !== "schedule-negotiation") {
    throw new Error("Expected dev timeout mutation for schedule-negotiation.");
  }
}
