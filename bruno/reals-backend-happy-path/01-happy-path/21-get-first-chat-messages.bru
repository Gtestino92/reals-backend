meta {
  name: 21 Get First Chat Messages
  type: http
  seq: 21
}

get {
  url: {{baseUrl}}/api/chats/{{firstChatId}}/messages
  body: none
  auth: none
}

headers {
  X-Dev-User-Id: {{userAId}}
}

script:post-response {
  const body = res.getBody();
  if (!Array.isArray(body) || body.length !== 2) {
    throw new Error(`Expected 2 first-chat messages, got ${Array.isArray(body) ? body.length : typeof body}`);
  }
  if (body[0].senderId !== bru.getEnvVar("userAId") || body[1].senderId !== bru.getEnvVar("userBId")) {
    throw new Error("Expected first-chat messages from user A then user B.");
  }
}
