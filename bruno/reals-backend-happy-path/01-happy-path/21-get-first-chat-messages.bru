meta {
  name: 21 Get First Chat Messages
  type: http
  seq: 21
}

get {
  url: {{baseUrl}}/api/chats/{{firstChatId}}/messages
  body: none
  auth: none
}

headers {
  X-Dev-User-Id: {{userAId}}
}

script:post-response {
  const body = res.getBody();
  if (!Array.isArray(body) || body.length !== 2) {
    throw new Error(`Expected 2 first-chat messages, got ${Array.isArray(body) ? body.length : typeof body}`);
  }
  const expectedUserAId = bru.getEnvVar("userAId");
  const expectedUserBId = bru.getEnvVar("userBId");
  if (body[0].senderId !== expectedUserAId || body[1].senderId !== expectedUserBId) {
    throw new Error(
      `Expected first-chat messages from user A then user B. ` +
      `Expected ${expectedUserAId}/${expectedUserBId}, got ${body[0].senderId}/${body[1].senderId}.`
    );
  }
}
