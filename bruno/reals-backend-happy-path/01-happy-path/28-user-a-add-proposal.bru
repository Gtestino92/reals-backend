meta {
  name: 28 User A Add Proposal
  type: http
  seq: 28
}

post {
  url: {{baseUrl}}/api/connections/{{connectionId}}/proposals
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Dev-User-Id: {{userAId}}
}

body:json {
  {
    "proposedDateTime": "{{secondChatDateTime}}"
  }
}

script:post-response {
  const body = res.getBody();
  bru.setEnvVar("proposalAId", body.id);
}
