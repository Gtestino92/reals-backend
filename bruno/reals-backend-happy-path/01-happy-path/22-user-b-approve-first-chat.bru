meta {
  name: 22 User B Approve First Chat
  type: http
  seq: 22
}

post {
  url: {{baseUrl}}/api/matches/{{matchId}}/chat/decision
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Dev-User-Id: {{userBId}}
}

body:json {
  {
    "decision": "APPROVED"
  }
}

script:post-response {
  const body = res.getBody();
  if (body.state !== "VISUAL_PHASE") {
    throw new Error("Expected match state VISUAL_PHASE after both chat approvals.");
  }
}
