meta {
  name: 00 Setup Run
  type: http
  seq: 0
}

get {
  url: {{baseUrl}}/api/ping
  body: none
  auth: none
}

script:pre-request {
  const clearEnvVars = (names) => names.forEach((name) => bru.setEnvVar(name, ""));
  clearEnvVars([
    "runId",
    "userAEmail",
    "userBEmail",
    "secondChatDateTime",
    "secondChatDateTimeLater",
    "secondChatDateTimeLatest",
    "userAId",
    "userBId",
    "profileAId",
    "profileAStatus",
    "profileBId",
    "profileBStatus",
    "matchId",
    "matchParticipant1Id",
    "matchParticipant2Id",
    "matchUserAId",
    "matchUserBId",
    "firstChatId",
    "connectionId",
    "negotiationId",
    "proposalAId",
    "proposalBId",
    "secondChatId",
    "secondChatExitRequestId"
  ]);

  const runId = Date.now().toString();
  const futureHalfHourSlot = (daysAhead, slotOffset) => {
    const hoursAhead = daysAhead * 24 + slotOffset;
    const date = new Date(Date.now() + hoursAhead * 60 * 60 * 1000);
    date.setUTCSeconds(0, 0);
    if (date.getUTCMinutes() < 30) {
      date.setUTCMinutes(30);
    } else {
      date.setUTCHours(date.getUTCHours() + 1, 0, 0, 0);
    }
    return date.toISOString();
  };

  bru.setEnvVar("runId", runId);
  bru.setEnvVar("userAEmail", `ana.local.${runId}@example.com`);
  bru.setEnvVar("userBEmail", `bruno.local.${runId}@example.com`);
  bru.setEnvVar("secondChatDateTime", futureHalfHourSlot(2, 0));
  bru.setEnvVar("secondChatDateTimeLater", futureHalfHourSlot(2, 1));
  bru.setEnvVar("secondChatDateTimeLatest", futureHalfHourSlot(2, 2));
}

script:post-response {
  const body = res.getBody();
  if (!body || body.status !== "ok") {
    throw new Error("Expected ping response { status: 'ok' }");
  }
}
