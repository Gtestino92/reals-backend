meta {
  name: 17 Process Matchmaking
  type: http
  seq: 17
}

post {
  url: {{baseUrl}}/api/local-dev/matchmaking/process?maxPairsPerRun=1
  body: none
  auth: none
}

script:post-response {
  const body = res.getBody();
  if (!body || body.matchesCreated < 1 || !body.pairs || !body.pairs[0]) {
    throw new Error("No match was created. Check profile activation and compatibility.");
  }

  const match = body.pairs[0];
  const expectedUserAId = bru.getEnvVar("userAId");
  const expectedUserBId = bru.getEnvVar("userBId");
  const participants = [match.userAId, match.userBId];

  if (!participants.includes(expectedUserAId) || !participants.includes(expectedUserBId)) {
    throw new Error(
      `Created match does not contain current run users. ` +
      `Expected ${expectedUserAId}/${expectedUserBId}, got ${match.userAId}/${match.userBId}. ` +
      `Reset the local database or clear stale matchmaking queue entries.`
    );
  }

  bru.setEnvVar("matchId", match.id);
  bru.setEnvVar("matchParticipant1Id", match.userAId);
  bru.setEnvVar("matchParticipant2Id", match.userBId);

  // Legacy aliases for backend match columns. Do not use these as Bruno persona A/B.
  bru.setEnvVar("matchUserAId", match.userAId);
  bru.setEnvVar("matchUserBId", match.userBId);
}
