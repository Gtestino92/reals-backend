meta {
  name: 04 Verify Identity A
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/me/profile/identity-verification
  body: none
  auth: none
}

headers {
  X-Dev-User-Id: {{userAId}}
}

script:post-response {
  const body = res.getBody();
  bru.setEnvVar("profileAIdentityVerified", body.identityVerified);
}
