meta {
  name: 11 Verify Authenticity B
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/api/me/profile/authenticity-verification
  body: none
  auth: none
}

headers {
  X-Dev-User-Id: {{userBId}}
}

script:post-response {
  const body = res.getBody();
  bru.setEnvVar("profileBAuthenticityVerified", body.authenticityVerified);
}
