meta {
  name: 10 Create Profile B
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/api/me/profile
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Dev-User-Id: {{userBId}}
}

body:json {
  {
    "displayName": "Bruno Local",
    "birthDate": "1994-09-22",
    "gender": "MALE",
    "lookingForGenders": ["FEMALE"],
    "intention": "DATE",
    "city": "Buenos Aires",
    "country": "AR",
    "bio": "Perfil local B para probar el flujo feliz.",
    "preferredMinAge": 18,
    "preferredMaxAge": 99,
    "maxDistanceKm": 50
  }
}

script:post-response {
  const body = res.getBody();
  bru.setEnvVar("profileBId", body.id);
}
