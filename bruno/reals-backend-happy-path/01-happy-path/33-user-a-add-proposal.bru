meta {
  name: 33 User A Add Proposal
  type: http
  seq: 33
}

post {
  url: {{baseUrl}}/api/connections/{{connectionId}}/proposals
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Dev-User-Id: {{userAId}}
}

body:json {
  {
    "proposedDateTimes": [
      "{{secondChatDateTimeLater}}",
      "{{secondChatDateTime}}"
    ]
  }
}

script:post-response {
  const body = res.getBody();
  bru.setEnvVar("proposalAId", body[0].id);
}
