meta {
  name: 05 Join User A
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/connections/{{connectionId}}/second-chat/join
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{second_chat_user_a_id_token}}
}

script:post-response {
  const body = res.getBody();
  if (body.myAttendanceStatus !== "ON_TIME" && body.myAttendanceStatus !== "LATE") {
    throw new Error(`Expected joined attendance, got ${body.myAttendanceStatus}`);
  }
  if (!body.chatId || !body.scheduledAt || !body.absoluteExpiresAt || !body.serverTime) {
    throw new Error("Expected second-chat attendance response after User A joins.");
  }
  bru.setEnvVar("secondChatId", body.chatId, { persist: true });
}
