meta {
  name: 22 User B Send First Chat Message
  type: http
  seq: 22
}

post {
  url: {{baseUrl}}/api/chats/{{firstChatId}}/messages
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Dev-User-Id: {{userBId}}
}

body:json {
  {
    "content": "Hola, respondo desde el usuario B."
  }
}

script:post-response {
  const body = res.getBody();
  const expectedUserAId = bru.getEnvVar("userAId");
  const expectedUserBId = bru.getEnvVar("userBId");
  if (!body || body.senderId !== expectedUserBId) {
    throw new Error(
      `Expected first-chat message from user B (${expectedUserBId}), got ${body?.senderId}. ` +
      `If it equals user A (${expectedUserAId}), check the local Bruno value for userBId or rerun from 00 Setup Run.`
    );
  }
}
