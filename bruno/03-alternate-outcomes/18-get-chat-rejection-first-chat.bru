meta {
  name: 18 Get Chat Rejection First Chat
  type: http
  seq: 18
}

get {
  url: {{baseUrl}}/api/matches/{{alternateMatchChatRejectedId}}/chat
  body: none
  auth: none
}

headers {
  X-Dev-User-Id: {{alternateUserAId}}
}

script:post-response {
  const body = res.getBody();
  bru.setEnvVar("alternateFirstChatRejectId", body.id);
}
