meta {
  name: 38 User B Approve Scheduling Visual
  type: http
  seq: 38
}

post {
  url: {{baseUrl}}/api/matches/{{alternateMatchSchedulingFailedId}}/visual-decision
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Dev-User-Id: {{alternateUserBId}}
}

body:json {
  {
    "decision": "APPROVED"
  }
}

script:post-response {
  const body = res.getBody();
  if (body.state !== "VISUAL_APPROVED") {
    throw new Error(`Expected VISUAL_APPROVED, got ${body.state}`);
  }
  if (!body.connectionId) {
    throw new Error("Mutual visual approval must create a connection.");
  }
  bru.setEnvVar("alternateConnectionSchedulingFailedId", body.connectionId);
}
