meta {
  name: 45 User A Reject Partner Proposals Round 2 Remains Round 2
  type: http
  seq: 45
}

post {
  url: {{baseUrl}}/api/connections/{{alternateConnectionSchedulingFailedId}}/negotiation/rejections
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Dev-User-Id: {{alternateUserAId}}
}

body:json {
  {
    "expectedRoundNumber": 2
  }
}

script:post-response {
  const body = res.getBody();
  if (body.status !== "PENDING" || body.roundNumber !== 2) {
    throw new Error(`Expected PENDING round 2, got ${body.status} round ${body.roundNumber}`);
  }
}
