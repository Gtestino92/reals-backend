meta {
  name: 36 User B Approve Scheduling First Chat
  type: http
  seq: 36
}

post {
  url: {{baseUrl}}/api/matches/{{alternateMatchSchedulingFailedId}}/chat-decision
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Dev-User-Id: {{alternateUserBId}}
}

body:json {
  {
    "decision": "APPROVED"
  }
}

script:post-response {
  const body = res.getBody();
  if (body.state !== "VISUAL_PHASE") {
    throw new Error(`Expected VISUAL_PHASE, got ${body.state}`);
  }
}
