meta {
  name: 42 User A Reject Partner Proposals Round 1 Remains Round 1
  type: http
  seq: 42
}

post {
  url: {{baseUrl}}/api/connections/{{alternateConnectionSchedulingFailedId}}/negotiation/rejections
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Dev-User-Id: {{alternateUserAId}}
}

body:json {
  {
    "expectedRoundNumber": 1
  }
}

script:post-response {
  const body = res.getBody();
  if (body.status !== "PENDING" || body.roundNumber !== 1) {
    throw new Error(`Expected PENDING round 1, got ${body.status} round ${body.roundNumber}`);
  }
}
