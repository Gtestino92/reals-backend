meta {
  name: 07 List Pending Review photo
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/api/admin/safety-reports/pending
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{firebase_admin_id_token}}
}

script:post-response {
  const body = res.getBody();
  
  if (!Array.isArray(body)) {
    throw new Error("Expected an array of safety reports.");
  }
  
  if (body.length > 0) {
    const first = body[0];
    bru.setEnvVar("safetyReportId", first.id);
    bru.setEnvVar("reportedUserId", first.reportedUserId);
    bru.setEnvVar("reporterUserId", first.reporterUserId);
    bru.setEnvVar("safetyReportStatus", first.status);
  }
}
