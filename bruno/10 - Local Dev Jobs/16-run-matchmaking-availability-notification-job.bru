meta {
  name: 16 Run Matchmaking Availability Notification Job
  type: http
  seq: 19
}

post {
  url: {{baseUrl}}/api/local-dev/jobs/matchmaking-availability-notification/run
  body: none
  auth: none
}

script:post-response {
  if (res.getBody().job !== "MatchmakingAvailabilityNotificationJob") {
    throw new Error("Expected MatchmakingAvailabilityNotificationJob to run.");
  }
}

docs {
  Discovers and processes due MATCHMAKING_AVAILABLE notification episodes for users recovering from the rolling Visual Advancement Cap. The job revalidates current cap, queue and matchmaking availability before sending.
}

