meta {
  name: Reorder User A Public Questions
  type: http
  seq: 32
}

put {
  url: {{baseUrl}}/api/me/profile/question-selections
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{profile_questions_user_a_id_token}}
  Content-Type: application/json
}

body:json {
  {"questionIds":["CURRENT_OBSESSION_001","PERFECT_SUNDAY_001","LIFE_SOUNDTRACK_001"]}
}

script:post-response {

  const status = res.getStatus();
  if (status !== 200) throw new Error(`Expected 200, got ${status}.`);
  const positions = new Map(res.getBody().answers.map((answer) => [answer.questionId, answer.selectedPosition]));
  if (positions.get("CURRENT_OBSESSION_001") !== 1 || positions.get("PERFECT_SUNDAY_001") !== 2 || positions.get("LIFE_SOUNDTRACK_001") !== 3) {
    throw new Error("Unexpected reordered selected positions.");
  }

}
