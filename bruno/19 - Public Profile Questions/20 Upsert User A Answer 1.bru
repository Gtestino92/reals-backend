meta {
  name: Upsert User A Answer 1
  type: http
  seq: 20
}

put {
  url: {{baseUrl}}/api/me/profile/question-answers/PERFECT_SUNDAY_001
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{profile_questions_user_a_id_token}}
  X-Firebase-AppCheck: {{firebase_app_check_token}}
  Content-Type: application/json
}

body:json {
  {"answer":"Caf?, piano y una caminata sin apuro."}
}

script:post-response {

  const status = res.getStatus();
  if (status !== 200) throw new Error(`Expected 200, got ${status}.`);
  const body = res.getBody();
  if (!Array.isArray(body.answers)) throw new Error("Expected answers array.");
  const answer = body.answers.find((item) => item.questionId === "PERFECT_SUNDAY_001");
  if (!answer || answer.answer !== "Caf?, piano y una caminata sin apuro.") throw new Error("Expected saved profile-question answer.");
  if (answer.current !== true) throw new Error("Expected current=true for saved answer.");

}
