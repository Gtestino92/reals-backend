meta {
  name: Upsert User A Answer 3
  type: http
  seq: 22
}

put {
  url: {{baseUrl}}/api/me/profile/question-answers/CURRENT_OBSESSION_001
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{profile_questions_user_a_id_token}}
  Content-Type: application/json
}

body:json {
  {"answer":"Aprender recetas nuevas."}
}

script:post-response {

  const status = res.getStatus();
  if (status !== 200) throw new Error(`Expected 200, got ${status}.`);
  const body = res.getBody();
  if (!Array.isArray(body.answers)) throw new Error("Expected answers array.");
  const answer = body.answers.find((item) => item.questionId === "CURRENT_OBSESSION_001");
  if (!answer || answer.answer !== "Aprender recetas nuevas.") throw new Error("Expected saved profile-question answer.");
  if (answer.current !== true) throw new Error("Expected current=true for saved answer.");

}
